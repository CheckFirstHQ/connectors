opencti:
  url: http://localhost
  token: CHANGEME

connector:
  id: CHANGEME
  name: Checkfirst Import Connector
  scope: checkfirst
  log_level: info
  duration_period: P7D

checkfirst:
  api_url: ChangeMe
  api_key: ChangeMe
  api_endpoint: /v1/articles
  since: P365D
  force_reprocess: false
  tlp_level: clear
  # Parallel Row → STIX (1 = sequential in main process)
  convert_workers: 1
  convert_batch_size: 32
  # Max unique objects per OpenCTI send (try 5000 / 2500 when benchmarking)
  bundle_size: 10000
  # Optional: also write JSON logs to a file (mount parent dir in Docker)
  # log_file: /var/log/checkfirst-connector/connector.log
